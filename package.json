{
  "name": "magazzino-woocommerce",
  "version": "0.1.35",
  "description": "App Windows semplice per gestire prezzi e quantita prodotti WooCommerce.",
  "author": "BluevipersX",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win nsis --dir --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BluevipersX/magazzino-woocommerce.git"
  },
  "build": {
    "appId": "it.magazzino.woocommerce",
    "productName": "Magazzino WooCommerce",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Magazzino-WooCommerce-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Magazzino WooCommerce"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BluevipersX",
        "repo": "magazzino-woocommerce",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12"
  }
}
